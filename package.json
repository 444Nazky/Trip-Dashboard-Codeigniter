{
  "name": "ionic-app-base",
  "version": "0.0.0",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "dev:admin": "node scripts/admin-watch.mjs",
    "build:admin": "node scripts/admin-watch.mjs --once",
    "sync:admin": "node scripts/admin-watch.mjs --sync-only",
    "status": "node scripts/dev-status.mjs",
    "cache:clean": "ng cache clean",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0"
  },
  "allowScripts": {
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": true
  }
}
